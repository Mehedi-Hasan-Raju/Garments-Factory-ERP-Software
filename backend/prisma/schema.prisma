generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
  LOCKED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
}

enum LocationType {
  RACK
  SHELF
  BIN
}

enum SalaryComponentType {
  EARNING
  DEDUCTION
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

enum StockMovementType {
  RECEIVE
  ISSUE
  TRANSFER
  ADJUSTMENT
}

enum SupplierType {
  MANUFACTURER
  DISTRIBUTOR
  WHOLESALER
  TRADER
  OTHER
}

enum RawMaterialType {
  FABRIC
  ACCESSORIES
  THREAD
  BUTTON
  ZIPPER
  LABEL
  PACKAGING
  OTHER
}

model Department {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(100)
  code        String  @unique @db.VarChar(30)
  description String? @db.Text
  isActive    Boolean @default(true)

  employees Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model Employee {
  id             String         @id @default(uuid()) @db.Uuid
  employeeCode   String         @unique @db.VarChar(50)
  firstName      String         @db.VarChar(100)
  lastName       String         @db.VarChar(100)
  email          String?        @unique @db.VarChar(150)
  phone          String?        @unique @db.VarChar(30)
  designation    String?        @db.VarChar(100)
  employmentType EmploymentType @default(FULL_TIME)
  joiningDate    DateTime?
  status         EmployeeStatus @default(ACTIVE)

  departmentId String?     @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  user         User?
  salaries     EmployeeSalary[]
  payrollItems PayrollItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId, status])
  @@index([firstName, lastName])
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(80)
  code        String  @unique @db.VarChar(50)
  description String? @db.Text
  isSystem    Boolean @default(false)
  isActive    Boolean @default(true)

  users       User[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(100)
  code        String  @unique @db.VarChar(120)
  module      String  @db.VarChar(80)
  description String? @db.Text

  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([module])
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.VarChar(150)
  passwordHash String     @db.VarChar(255)
  status       UserStatus @default(ACTIVE)

  roleId String @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  employeeId String?   @unique @db.Uuid
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  lastLoginAt DateTime?
  sessions    UserSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId, status])
}

model UserSession {
  id               String @id @default(uuid()) @db.Uuid
  refreshTokenHash String @unique @db.VarChar(255)
  userId           String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?   @db.VarChar(45)
  userAgent String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model Warehouse {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(100)
  code        String  @unique @db.VarChar(30)
  description String? @db.Text
  isActive    Boolean @default(true)

  locations      WarehouseLocation[]
  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([name])
}

model WarehouseLocation {
  id   String       @id @default(uuid()) @db.Uuid
  name String       @db.VarChar(100)
  code String       @db.VarChar(30)
  type LocationType

  warehouseId String    @db.Uuid
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  parentId String?             @db.Uuid
  parent   WarehouseLocation?  @relation("LocationHierarchy", fields: [parentId, warehouseId], references: [id, warehouseId], onDelete: Restrict)
  children WarehouseLocation[] @relation("LocationHierarchy")

  inventoryStocks    InventoryStock[]
  stockMovementsFrom StockMovement[]  @relation("StockMovementFrom")
  stockMovementsTo   StockMovement[]  @relation("StockMovementTo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([warehouseId, code])
  @@unique([id, warehouseId])
  @@index([warehouseId, type])
  @@index([parentId])
}

model SalaryComponent {
  id          String              @id @default(uuid()) @db.Uuid
  name        String              @db.VarChar(100)
  code        String              @unique @db.VarChar(50)
  type        SalaryComponentType
  description String?             @db.Text
  isActive    Boolean             @default(true)

  employeeSalaryComponents EmployeeSalaryComponent[]
  payrollItemComponents    PayrollItemComponent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, isActive])
}

model EmployeeSalary {
  id            String    @id @default(uuid()) @db.Uuid
  employeeId    String    @db.Uuid
  basicSalary   Decimal   @db.Decimal(12, 2)
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  note          String?   @db.Text

  employee   Employee                  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  components EmployeeSalaryComponent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, effectiveFrom])
  @@index([effectiveTo])
}

model EmployeeSalaryComponent {
  id               String  @id @default(uuid()) @db.Uuid
  employeeSalaryId String  @db.Uuid
  componentId      String  @db.Uuid
  amount           Decimal @db.Decimal(12, 2)

  employeeSalary EmployeeSalary  @relation(fields: [employeeSalaryId], references: [id], onDelete: Cascade)
  component      SalaryComponent @relation(fields: [componentId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([employeeSalaryId, componentId])
  @@index([componentId])
}

model Payroll {
  id       String        @id @default(uuid()) @db.Uuid
  year     Int
  month    Int
  currency String        @default("BDT") @db.VarChar(3)
  status   PayrollStatus @default(DRAFT)

  totalBasicSalary Decimal @default(0) @db.Decimal(14, 2)
  totalEarnings    Decimal @default(0) @db.Decimal(14, 2)
  totalDeductions  Decimal @default(0) @db.Decimal(14, 2)
  totalOvertime    Decimal @default(0) @db.Decimal(14, 2)
  totalBonus       Decimal @default(0) @db.Decimal(14, 2)
  totalNetSalary   Decimal @default(0) @db.Decimal(14, 2)

  generatedAt DateTime  @default(now())
  approvedAt  DateTime?
  paidAt      DateTime?

  items PayrollItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, month])
  @@index([status, year, month])
}

model PayrollItem {
  id         String @id @default(uuid()) @db.Uuid
  payrollId  String @db.Uuid
  employeeId String @db.Uuid

  // Salary snapshot
  basicSalary    Decimal @db.Decimal(12, 2)
  overtimeAmount Decimal @default(0) @db.Decimal(12, 2)
  bonusAmount    Decimal @default(0) @db.Decimal(12, 2)
  otherDeduction Decimal @default(0) @db.Decimal(12, 2)

  grossSalary     Decimal @db.Decimal(12, 2)
  totalDeductions Decimal @db.Decimal(12, 2)
  netSalary       Decimal @db.Decimal(12, 2)

  daysInMonth Int
  paidDays    Int

  payroll  Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  components PayrollItemComponent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([payrollId, employeeId])
  @@index([employeeId])
}

model PayrollItemComponent {
  id            String  @id @default(uuid()) @db.Uuid
  payrollItemId String  @db.Uuid
  componentId   String? @db.Uuid

  // Snapshot: component name/type must remain unchanged in old payrolls
  componentName String              @db.VarChar(100)
  componentCode String              @db.VarChar(50)
  type          SalaryComponentType
  amount        Decimal             @db.Decimal(12, 2)

  payrollItem PayrollItem      @relation(fields: [payrollItemId], references: [id], onDelete: Cascade)
  component   SalaryComponent? @relation(fields: [componentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([payrollItemId])
  @@index([componentId])
}

model ProductCategory {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(100)
  code        String  @unique @db.VarChar(30)
  description String? @db.Text
  isActive    Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([name])
}

model UnitOfMeasure {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(50)
  code        String  @unique @db.VarChar(20)
  description String? @db.Text
  isActive    Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Product {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(150)
  sku         String  @unique @db.VarChar(80)
  description String? @db.Text

  categoryId String          @db.Uuid
  category   ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  unitId String        @db.Uuid
  unit   UnitOfMeasure @relation(fields: [unitId], references: [id], onDelete: Restrict)

  isActive           Boolean             @default(true)
  batchLots          BatchLot[]
  inventoryStocks    InventoryStock[]
  stockMovements     StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([categoryId, isActive])
  @@index([unitId])
  @@index([isActive])
}

model BatchLot {
  id          String    @id @default(uuid()) @db.Uuid
  batchNo     String    @db.VarChar(100)
  productId   String    @db.Uuid
  receivedAt  DateTime  @default(now())
  expiryDate  DateTime?
  description String?   @db.Text
  isActive    Boolean   @default(true)

  product   Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  stocks    InventoryStock[]
  movements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, batchNo])
  @@index([productId])
  @@index([expiryDate])
  @@index([isActive])
}

model InventoryStock {
  id         String @id @default(uuid()) @db.Uuid
  productId  String @db.Uuid
  locationId String @db.Uuid
  batchLotId String @db.Uuid

  quantity     Decimal @default(0) @db.Decimal(18, 3)
  minimumStock Decimal @default(0) @db.Decimal(18, 3)

  product  Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  location WarehouseLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  batchLot BatchLot          @relation(fields: [batchLotId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, locationId, batchLotId])
  @@index([productId])
  @@index([locationId])
  @@index([batchLotId])
  @@index([quantity])
}

model StockMovement {
  id         String            @id @default(uuid()) @db.Uuid
  movementNo String            @unique @db.VarChar(50)
  type       StockMovementType

  productId  String @db.Uuid
  batchLotId String @db.Uuid

  fromLocationId String? @db.Uuid
  toLocationId   String? @db.Uuid

  quantity Decimal @db.Decimal(18, 3)

  referenceNo String? @db.VarChar(100)
  note        String? @db.Text

  // Authenticated user- ID
  createdById String @db.Uuid

  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  batchLot BatchLot @relation(fields: [batchLotId], references: [id], onDelete: Restrict)

  fromLocation WarehouseLocation? @relation("StockMovementFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation   WarehouseLocation? @relation("StockMovementTo", fields: [toLocationId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([productId, createdAt])
  @@index([batchLotId])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([createdById])
  @@index([referenceNo])
}

model Supplier {
  id            String  @id @default(uuid()) @db.Uuid
  supplierCode  String  @unique @db.VarChar(50)
  supplierName  String  @db.VarChar(150)
  companyName   String  @db.VarChar(150)
  contactPerson String? @db.VarChar(120)
  phone         String  @db.VarChar(30)
  email         String? @db.VarChar(150)
  address       String? @db.Text

  supplierType     SupplierType
  rawMaterialTypes RawMaterialType[] @default([])

  notes          String?         @db.Text
  isActive       Boolean         @default(true)
  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierName])
  @@index([companyName])
  @@index([phone])
  @@index([supplierType, isActive])
  @@index([isActive])
}

model PurchaseOrder {
  id       String @id @default(uuid()) @db.Uuid
  poNumber String @unique @db.VarChar(50)

  supplierId  String @db.Uuid
  warehouseId String @db.Uuid

  orderDate            DateTime  @default(now())
  expectedDeliveryDate DateTime?

  status PurchaseOrderStatus @default(DRAFT)

  subtotal    Decimal @default(0) @db.Decimal(18, 2)
  discount    Decimal @default(0) @db.Decimal(18, 2)
  tax         Decimal @default(0) @db.Decimal(18, 2)
  totalAmount Decimal @default(0) @db.Decimal(18, 2)

  notes              String? @db.Text
  termsAndConditions String? @db.Text

  createdById  String    @db.Uuid
  approvedById String?   @db.Uuid
  approvedAt   DateTime?

  supplier  Supplier  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  items PurchaseOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId, orderDate])
  @@index([warehouseId])
  @@index([status, orderDate])
  @@index([createdById])
  @@index([approvedById])
}

model PurchaseOrderItem {
  id String @id @default(uuid()) @db.Uuid

  purchaseOrderId String @db.Uuid
  productId       String @db.Uuid

  quantity         Decimal @db.Decimal(18, 3)
  receivedQuantity Decimal @default(0) @db.Decimal(18, 3)

  unitPrice Decimal @db.Decimal(18, 2)
  lineTotal Decimal @db.Decimal(18, 2)

  notes String? @db.Text

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseOrderId, productId])
  @@index([productId])
}
